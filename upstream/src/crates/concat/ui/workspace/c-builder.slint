// SPDX-License-Identifier: AGPL-3.0-or-later
// C Builder lives inside Concat. It is not a second executable.
import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { CBuilderSelectionPanel, CBuilderKeywordData } from "c-builder-selection.slint";
import { Select } from "../primitives/select.slint";

component CField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    height: 32px;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;
    input := TextInput {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 16px;
        height: self.preferred-height;
        single-line: true;
        color: Theme.fg;
        font-size: Theme.fs;
        text <=> root.value;
    }
    if root.value == "" && !input.has-focus: Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.fg-muted;
        font-size: Theme.fs;
    }
}

export component CBuilderPane inherits VerticalLayout {
    in property <string> media-folder;
    in property <string> narration;
    in property <string> status;
    in property <string> keywords;
    in property <int> image-count;
    in property <int> video-count;
    in property <int> cache-reused;
    in property <int> cache-probed;
    in property <int> scan-done;
    in property <int> scan-total;
    in property <bool> busy;
    in property <string> profile;
    in property <[string]> profile-names;
    property <int> profile-index: 1;
    property <string> pin-index;
    property <bool> confirm-delete: false;
    in property <[CBuilderKeywordData]> image-keywords;
    in property <[CBuilderKeywordData]> video-keywords;
    in property <bool> videos-enabled;
    in property <string> image-selection-summary;
    in property <string> video-selection-summary;
    callback keyword-changed(json: string, video: bool, keyword: string, selected: bool, weight: int);
    callback videos-toggled(json: string, on: bool);
    in property <string> preview;
    callback plan-profile(json: string, images: string, videos: string, action: string);
    property <string> edited-profile: root.profile == "" ? "{\"version\":1,\"name\":\"Video-Heavy Opening\",\"curve\":[{\"at\":0,\"video\":0.65},{\"at\":0.25,\"video\":0.45},{\"at\":0.75,\"video\":0.2},{\"at\":1,\"video\":0.05}],\"imageSeconds\":[3,5],\"videoSeconds\":[2.5,4],\"maxVideos\":2,\"maxImages\":0,\"cooldown\":3,\"allowRepeats\":true,\"ratioBySeconds\":true,\"seed\":1}" : root.profile;
    in property <float> narration-duration;

    callback import-folder();
    callback refresh-folder();
    callback choose-narration();
    callback generate-project(name: string, image-weights: string, video-weights: string, coverage: int, profile: string);

    changed profile => { root.edited-profile = root.profile; root.confirm-delete = false; }
    property <int> page: 0;
    property <string> project-name: "New Timeline";
    property <string> images-weights: "";
    property <string> videos-weights: "";
    property <int> video-coverage: 20;

    padding: 10px;
    spacing: 12px;

    Text { text: "C BUILDER"; color: Theme.fg; font-size: Theme.fs-lg; font-weight: Theme.weight-title; }
    HorizontalLayout {
        spacing: 6px;
        Button {
            label: "Media Library";
            primary: root.page == 0;
            clicked => { root.page = 0; }
        }
        Button {
            label: "Timeline Builder";
            primary: root.page == 1;
            clicked => { root.page = 1; }
        }        Button { label: "Media Selection"; primary: root.page == 2; clicked => { root.page = 2; } }

    }
    if root.page == 0: VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            Button {
                label: "Import Folder";
                enabled: !root.busy;
                clicked => { root.import-folder(); }
            }
            Button {
                label: "Refresh";
                enabled: !root.busy && root.media-folder != "";
                clicked => { root.refresh-folder(); }
            }
        }
        Text {
            text: root.media-folder == "" ? "Choose a media folder. Originals are never moved or deleted."
                : root.media-folder;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text {
            text: "Images: \{root.image-count}     Videos: \{root.video-count}";
            color: Theme.fg;
            font-size: Theme.fs;
        }
        Text {
            text: "New/changed probed: \{root.cache-probed}     Reused from cache: \{root.cache-reused}";
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
        }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.field;
            Rectangle {
                width: parent.width * (root.scan-total > 0
                    ? Math.min(1.0, root.scan-done * 1.0 / root.scan-total)
                    : 0.0);
                height: parent.height;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
        Text {
            text: root.busy ? "Scanning media: \{root.scan-done} / \{root.scan-total}"
                : root.status;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text { text: "Keyword groups"; color: Theme.fg; font-weight: Theme.weight-title; }
        Text {
            text: root.keywords == "" ? "Import a folder to view image/video groups." : root.keywords;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text {
            text: "Media previews remain available in Concat's existing Media tab.";
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
        }
    }
    if root.page == 2: CBuilderSelectionPanel {
        images: root.image-keywords; videos: root.video-keywords; videos-enabled: root.videos-enabled;
        busy: root.busy; image-summary: root.image-selection-summary; video-summary: root.video-selection-summary;
        changed(video, keyword, selected, weight) => { root.keyword-changed(root.edited-profile, video, keyword, selected, weight); }
        videos-toggled(on) => { root.videos-toggled(root.edited-profile, on); }
    }
    if root.page == 1: VerticalLayout {
        spacing: 10px;
        Text { text: "Narration"; color: Theme.fg; font-weight: Theme.weight-title; }
        Button {
            label: "Select Audio";
            enabled: !root.busy;
            clicked => { root.choose-narration(); }
        }
        Text {
            text: root.narration == "" ? "Select an MP3/WAV narration." : root.narration;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text {
            text: "Narration duration: \{Math.round(root.narration-duration * 100) / 100} seconds";
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
        }
        Text { text: "New Concat project name"; color: Theme.fg; }
        CField { value <=> root.project-name; placeholder: "Project name"; }
        Button { label: "Choose Media with Sliders"; clicked => { root.page = 2; } }
        Select { options: root.profile-names; current <=> root.profile-index;
            changed(index) => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "select:\{index}"); } }
        Text { text: "Planning profile (versioned JSON)"; color: Theme.fg; }
        Text { text: "Edit curve weights (0–1), shot durations, run limits (0 = unlimited), cooldown and seed. Save/import named profiles without rebuilding.";
            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        Rectangle {
            height: 180px; background: Theme.field; border-radius: Theme.r;
            TextInput { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                text <=> root.edited-profile; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap; }
        }
        HorizontalLayout {
            Button { label: "Store Named Profile"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "store"); } }
            Button { label: "Duplicate"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "duplicate"); } }
            Button { label: "Rename"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "rename"); } }
        }
        Button { label: root.confirm-delete ? "Confirm Delete Saved Profile" : "Delete Saved Profile";
            clicked => { if root.confirm-delete {root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "delete");root.confirm-delete=false;} else {root.confirm-delete=true;} } }
        HorizontalLayout {
            Button { label: "Import Profile"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "load"); } }
            Button { label: "Save Profile"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "save"); } }
        }
        HorizontalLayout {
            Button { label: "Preview Plan"; enabled: !root.busy; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "preview"); } }
            Button { label: "Reroll"; enabled: !root.busy; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "reroll"); } }
        }
        CField { value <=> root.pin-index; placeholder: "Storyboard shot number to pin"; }
        HorizontalLayout {
            Button { label: "Pin Preview Shot"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "pin:\{root.pin-index}"); } }
            Button { label: "Clear Pins"; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "clear-pins"); } }
        }
        Text { text: root.preview; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        Button {
            label: "Generate Native Concat Timeline";
            primary: true;
            enabled: !root.busy && (root.image-count + root.video-count) > 0 && root.narration != "";
            clicked => {
                root.generate-project(root.project-name, root.images-weights,
                    root.videos-weights, root.video-coverage, root.edited-profile);
            }
        }
        Text {
            text: root.status;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}