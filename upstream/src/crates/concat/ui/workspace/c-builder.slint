// C Builder lives inside Concat. It is not a second executable.
import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { CBuilderSelectionPanel, CBuilderKeywordData } from "c-builder-selection.slint";
import { Param, ParamFormat } from "../inspector/controls.slint";

component CField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    callback edited(value:string);
    height: 32px;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.field;
    input := TextInput {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 16px;
        height: self.preferred-height;
        single-line: true;
        color: Theme.fg;
        font-size: Theme.fs;
        text <=> root.value;
        edited=>{root.edited(self.text);}
    }
    if root.value == "" && !input.has-focus: Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.fg-muted;
        font-size: Theme.fs;
    }
}


component TuneField inherits VerticalLayout {
    in property <string> caption;
    in-out property <string> value;
    spacing: 3px;
    Text { text: root.caption; color: Theme.fg-muted; font-size: Theme.fs-sm; }
    CField { value <=> root.value; }
}

export component CBuilderPane inherits VerticalLayout {
    in property <string> media-folder;
    in property <string> intro-folder;
    in property <int> intro-count;
    in property <int> intro-probed;
    in property <int> intro-reused;
    in property <string> intro-summary;
    in property <[CBuilderKeywordData]> intro-keywords;
    in property <string> intro-selection-summary;
    callback import-intro-folder();
    callback refresh-intro-folder();
    callback clear-intro-folder();
    callback intro-keyword-changed(json:string,keyword:string,selected:bool,weight:int);
    callback equalize-intro-keywords(json:string);
    in property <string> narration;
    in property <string> status;
    in property <string> keywords;
    in property <int> image-count;
    in property <int> video-count;
    in property <int> cache-reused;
    in property <int> cache-probed;
    in property <int> scan-done;
    in property <int> scan-total;
    in property <bool> busy;
    in property <bool> generating;
    in property <string> profile;
    in property <float> plan-opening:65;
    in property <float> plan-closing:5;
    in property <float> plan-intro:0;
    property <float> intro-max: Math.floor(root.narration-duration / 3);
    property <float> tune-intro: Math.min(root.plan-intro, root.intro-max);
    changed plan-intro => { root.tune-intro = Math.min(root.plan-intro,root.intro-max); }
    changed intro-max => { root.tune-intro = Math.min(root.plan-intro,root.intro-max); }
    in property <string> plan-image-min;
    in property <string> plan-image-max;
    in property <string> plan-video-min;
    in property <string> plan-video-max;
    in property <string> plan-max-videos;
    in property <string> plan-max-images;
    in property <string> plan-cooldown;
    in property <string> plan-seed;
    property <float> tune-opening: root.plan-opening;
    property <float> tune-closing: root.plan-closing;
    property <string> tune-image-min: root.plan-image-min;
    property <string> tune-image-max: root.plan-image-max;
    property <string> tune-video-min: root.plan-video-min;
    property <string> tune-video-max: root.plan-video-max;
    property <string> tune-max-videos: root.plan-max-videos;
    property <string> tune-max-images: root.plan-max-images;
    property <string> tune-cooldown: root.plan-cooldown;
    property <string> tune-seed: root.plan-seed;
    changed plan-opening => { root.tune-opening = root.plan-opening; }
    changed plan-closing => { root.tune-closing = root.plan-closing; }
    changed plan-image-min => { root.tune-image-min = root.plan-image-min; }
    changed plan-image-max => { root.tune-image-max = root.plan-image-max; }
    changed plan-video-min => { root.tune-video-min = root.plan-video-min; }
    changed plan-video-max => { root.tune-video-max = root.plan-video-max; }
    changed plan-max-videos => { root.tune-max-videos = root.plan-max-videos; }
    changed plan-max-images => { root.tune-max-images = root.plan-max-images; }
    changed plan-cooldown => { root.tune-cooldown = root.plan-cooldown; }
    changed plan-seed => { root.tune-seed = root.plan-seed; }
    callback tune-profile(json:string, opening:float, closing:float, intro:float,
        image-min:string, image-max:string, video-min:string, video-max:string,
        max-videos:string, max-images:string, cooldown:string, seed:string);
    callback equalize-keywords(json:string, video:bool);
    in property <[CBuilderKeywordData]> image-keywords;
    in property <[CBuilderKeywordData]> video-keywords;
    in property <bool> videos-enabled;
    in property <float> overall-video-ratio: 30;
    callback ratio-changed(value:int);
    in property <string> image-selection-summary;
    in property <string> video-selection-summary;
    callback keyword-changed(json: string, video: bool, keyword: string, selected: bool, weight: int);
    callback videos-toggled(json: string, on: bool);
    in property <string> preview;
    callback plan-profile(json: string, images: string, videos: string, action: string);
    out property <string> draft-profile: root.edited-profile;
    property <string> edited-profile: root.profile == "" ? "{\"version\":1,\"name\":\"Video-Heavy Opening\",\"curve\":[{\"at\":0,\"video\":0.65},{\"at\":0.25,\"video\":0.45},{\"at\":0.75,\"video\":0.2},{\"at\":1,\"video\":0.05}],\"imageSeconds\":[3,5],\"videoSeconds\":[2.5,4],\"maxVideos\":2,\"maxImages\":0,\"cooldown\":3,\"allowRepeats\":true,\"ratioBySeconds\":true,\"seed\":1}" : root.profile;
    in property <float> narration-duration;

    callback import-folder();
    callback refresh-folder();
    callback choose-narration();
    callback generate-project(name: string, image-weights: string, video-weights: string, coverage: int, profile: string);

    changed profile => { root.edited-profile = root.profile; }
    in-out property <int> page: 0;
    in property <string> project-name;
    in property <bool> name-overridden;
    in property <string> name-preview;
    in property <bool> can-generate: true;
    callback project-name-edited(value:string);
    callback reset-project-name();
    property <string> edited-name: root.project-name;
    changed project-name=>{root.edited-name=root.project-name;}
    property <string> images-weights: "";
    property <string> videos-weights: "";
    property <int> video-coverage: 20;

    padding: 8px;
    spacing: 8px;

    if root.page == 0: VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
        spacing:16px;
        VerticalLayout {
        horizontal-stretch:1;spacing:10px;
        Text { text: "Media Library"; color: Theme.fg; font-size: Theme.fs-lg; font-weight: Theme.weight-title; }
        HorizontalLayout {
            spacing: 6px;
            Button {
                label: "Import Folder";
                enabled: !root.busy;
                clicked => { root.import-folder(); }
            }
            Button {
                label: "Refresh";
                enabled: !root.busy && root.media-folder != "";
                clicked => { root.refresh-folder(); }
            }
        }
        Text {
            text: root.media-folder == "" ? "Choose a media folder. Successful generation moves consumed media into used/Project Name/."
                : root.media-folder;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text {
            text: "Images: \{root.image-count}     Videos: \{root.video-count}";
            color: Theme.fg;
            font-size: Theme.fs;
        }
        Text {
            text: "New/changed probed: \{root.cache-probed}     Reused from cache: \{root.cache-reused}";
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
        }
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.field;
            Rectangle {
                width: parent.width * (root.scan-total > 0
                    ? Math.min(1.0, root.scan-done * 1.0 / root.scan-total)
                    : 0.0);
                height: parent.height;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
        Text {
            text: root.busy && !root.generating ? "Scanning media: \{root.scan-done} / \{root.scan-total}"
                : root.status;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        Text { text: "Keyword groups"; color: Theme.fg; font-weight: Theme.weight-title; }
        Text {
            text: root.keywords == "" ? "Import a folder to view image/video groups." : root.keywords;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
        }
        Rectangle { width:1px; background:Theme.line; }
        VerticalLayout {
            horizontal-stretch:1;spacing:10px;
            Text { text:"Intro Clips Library";color:Theme.fg;font-size:Theme.fs-lg;font-weight:Theme.weight-title; }
            HorizontalLayout {
                spacing:6px;
                Button {label:"Import Folder";enabled:!root.busy;clicked=>{root.import-intro-folder();}}
                Button {label:"Refresh";enabled:!root.busy&&root.intro-folder!="";clicked=>{root.refresh-intro-folder();}}
                Button {label:"Clear";enabled:!root.busy&&root.intro-folder!="";clicked=>{root.clear-intro-folder();}}
            }
            Text {text:root.intro-folder==""?"Optional intro-only folder. Otherwise normal media supplies the intro.":root.intro-folder;color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
            Text {text:"Videos: "+root.intro-count;color:Theme.fg;font-size:Theme.fs;}
            Text {text:"New/changed probed: "+root.intro-probed+"    Reused from cache: "+root.intro-reused;color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
            Text {text:"Keyword groups";color:Theme.fg;font-weight:Theme.weight-title;}
            Text {text:root.intro-summary==""?"Import a folder to view intro video groups.":root.intro-summary;color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
            Text {text:"Consumed intro clips move into this library's used/Project Name/.";color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
        }
        }
        Text {
            text: "Media previews remain available in Concat's existing Media tab.";
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
        }
    }
    if root.page == 2: CBuilderSelectionPanel {
        images: root.image-keywords; videos: root.video-keywords; videos-enabled: root.videos-enabled;
        intro-configured:root.intro-folder!="";intro-videos:root.intro-keywords;intro-summary:root.intro-selection-summary;
        intro-changed(keyword,selected,weight)=>{root.intro-keyword-changed(root.edited-profile,keyword,selected,weight);}
        equalize-intro=>{root.equalize-intro-keywords(root.edited-profile);}
        overall-video-ratio:root.overall-video-ratio; ratio-changed(value)=>{root.ratio-changed(value);}
        busy: root.busy; image-summary: root.image-selection-summary; video-summary: root.video-selection-summary;
        changed(video, keyword, selected, weight) => { root.keyword-changed(root.edited-profile, video, keyword, selected, weight); }
        equalize(video) => { root.equalize-keywords(root.edited-profile, video); }
        videos-toggled(on) => { root.videos-toggled(root.edited-profile, on); }
    }
    if root.page == 1: VerticalLayout {
        spacing: 9px;
        Text { text: "Timeline Builder"; color: Theme.fg; font-size: Theme.fs-lg;
            font-weight: Theme.weight-title; }
        Text { text: "Narration & project"; color: Theme.fg; font-weight: Theme.weight-title; }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Select Audio"; enabled: !root.busy; clicked => { root.choose-narration(); } }
            Text { text: "Duration: \{Math.round(root.narration-duration * 100) / 100}s";
                color: Theme.fg-muted; font-size: Theme.fs-sm; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.narration == "" ? "Select an MP3/WAV narration." : root.narration;
            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        Text { text: "Project name"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        CField { max-width: 520px; value <=> root.edited-name; placeholder: "From narration"; edited(value)=>{root.project-name-edited(value);} }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Use Audio Name"; enabled: !root.busy && root.narration != ""; clicked => { root.reset-project-name(); } }
            Button { label: "Media Selection"; enabled: !root.busy; clicked => { root.page = 2; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.name-preview; color: Theme.fg-muted; wrap: word-wrap; font-size: Theme.fs-sm; }

        Rectangle { height: 1px; background: Theme.line; }
        Text { text: "Timeline Planning"; color: Theme.fg; font-weight: Theme.weight-title; }
        Text { text: "Video distribution across timeline · %"; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 16px;
            Param { label: "Opening video %"; value <=> root.tune-opening; rail: true; minimum:0; maximum:100; step:1; unit:"%"; fmt:ParamFormat.steps; enabled: !root.busy; horizontal-stretch:1; }
            Param { label: "Ending video %"; value <=> root.tune-closing; rail: true; minimum:0; maximum:100; step:1; unit:"%"; fmt:ParamFormat.steps; enabled: !root.busy; horizontal-stretch:1; }
            Param { label: "Video-only intro (0 = off)"; value <=> root.tune-intro; rail: true; minimum:0; maximum:Math.max(1,root.intro-max); step:1; unit:"s"; fmt:ParamFormat.steps; enabled: !root.busy && root.intro-max > 0; horizontal-stretch:1; }
        }
        Text { text: "Shot duration range · seconds"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        HorizontalLayout {
            spacing: 8px;
            TuneField { max-width: 215px; caption: "Image min"; value <=> root.tune-image-min; }
            TuneField { max-width: 215px; caption: "Image max"; value <=> root.tune-image-max; }
            TuneField { max-width: 215px; caption: "Video min"; value <=> root.tune-video-min; }
            TuneField { max-width: 215px; caption: "Video max"; value <=> root.tune-video-max; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: "Humanized sequence · 0 run limit = unlimited"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        HorizontalLayout {
            spacing: 8px;
            TuneField { max-width: 215px; caption: "Max video run"; value <=> root.tune-max-videos; }
            TuneField { max-width: 215px; caption: "Max image run"; value <=> root.tune-max-images; }
            TuneField { max-width: 215px; caption: "Repeat cooldown"; value <=> root.tune-cooldown; }
            TuneField { max-width: 215px; caption: "Random seed"; value <=> root.tune-seed; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Apply Planning Settings"; primary: true; enabled: !root.busy;
                clicked => {
                    root.tune-profile(root.edited-profile, root.tune-opening, root.tune-closing, root.tune-intro,
                        root.tune-image-min, root.tune-image-max, root.tune-video-min, root.tune-video-max,
                        root.tune-max-videos, root.tune-max-images, root.tune-cooldown, root.tune-seed);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: "Apply settings before previewing. Applied settings are remembered; overall video ratio and keyword shares are controlled from Media Selection.";
            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }

        Rectangle { height: 1px; background: Theme.line; }
        Text { text: "Preview & generate"; color: Theme.fg; font-weight: Theme.weight-title; }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Preview Plan"; enabled: !root.busy && root.narration != "" && (root.image-count+root.video-count)>0; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "preview"); } }
            Button { label: "Preview Intro"; enabled: !root.busy && root.plan-intro > 0 && root.narration != "" && (root.image-count+root.video-count)>0; clicked => { root.plan-profile(root.edited-profile,root.images-weights,root.videos-weights,"intro"); } }
            Button { label: "Preview Video"; enabled: !root.busy && root.narration != "" && (root.image-count+root.video-count)>0; clicked => { root.plan-profile(root.edited-profile,root.images-weights,root.videos-weights,"video"); } }
            Button { label: "Reroll"; enabled: !root.busy && root.narration != "" && (root.image-count+root.video-count)>0; clicked => { root.plan-profile(root.edited-profile, root.images-weights, root.videos-weights, "reroll"); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.preview == "" ? "Preview a deterministic plan before generating." : root.preview;
            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        HorizontalLayout {
            Button {
                label: "Generate Native Concat Timeline";
                primary: true;
                enabled: root.can-generate && !root.busy && (root.image-count + root.video-count) > 0 && root.narration != "";
                clicked => {
                    root.generate-project(root.edited-name, root.images-weights,
                        root.videos-weights, root.video-coverage, root.edited-profile);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.status; color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
    }
}
