import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { Check } from "../inspector/controls.slint";
import { IconButton } from "../primitives/panel.slint";
import { Glyph } from "../icons.slint";
import { LibraryFocus } from "library-focus.slint";
export global ParticleBulk {
    pure public function index-of(id: string) -> int {
        return id == "concat.particles-stars" ? 0 :
            id == "concat.particles-gold-sparkles" ? 1 :
            id == "concat.particles-embers" ? 2 :
            id == "concat.particles-fireflies" ? 3 :
            id == "concat.particles-bokeh" ? 4 :
            id == "concat.particles-dust-motes" ? 5 :
            id == "concat.particles-snow" ? 6 :
            id == "concat.particles-rain" ? 7 :
            id == "concat.particles-ash" ? 8 :
            id == "concat.particles-light-leaks" ? 9 :
            id == "concat.particles-shooting-stars" ? 10 :
            id == "concat.particles-confetti" ? 11 : -1;
    }

    callback apply(preset: int, mode: int, selected-only: bool, images: bool, videos: bool);
    callback toggle-favourite(index: int);
    in property <[bool]> favourites;
    in-out property <int> preset: 0;
    in-out property <bool> images: true;
    in-out property <bool> videos: true;
}
export component ParticleEffectsPanel inherits VerticalLayout {
    property <int> preset <=> ParticleBulk.preset;
    property <bool> images <=> ParticleBulk.images;
    property <bool> videos <=> ParticleBulk.videos;
    spacing: 8px;
    Text { text: "Particle Overlay Settings"; color: Theme.fg; font-size: Theme.fs; }
    Text { text: LibraryFocus.selected-name; color: Theme.fg-muted; wrap: word-wrap; }

    HorizontalLayout {
        Check { checked: root.images; toggled(on) => { root.images = on; } }
        Text { text: "Images"; color: Theme.fg; }
        Check { checked: root.videos; toggled(on) => { root.videos = on; } }
        Text { text: "Videos"; color: Theme.fg; }
    }
    Text { text: "Applied overlay parameters remain editable in Effects.";
        color: Theme.fg-muted; wrap: word-wrap; font-size: Theme.fs-sm; }
}

// The inspector scrolls settings, but not the five existing Apply actions.
// No new bulk modes are introduced; the Rust dispatch parameters are unchanged.
export component ParticleApplyBar inherits VerticalLayout {
    property <int> preset <=> ParticleBulk.preset;
    property <bool> images <=> ParticleBulk.images;
    property <bool> videos <=> ParticleBulk.videos;
    spacing: 5px;
    padding: 8px;
    HorizontalLayout {
        spacing: 6px;
        Button { label: "Apply Selected"; enabled: root.images || root.videos; clicked => { ParticleBulk.apply(root.preset, 0, true, root.images, root.videos); } }
        Button { label: "Apply All"; enabled: root.images || root.videos; clicked => { ParticleBulk.apply(root.preset, 0, false, root.images, root.videos); } }
    }
    HorizontalLayout {
        spacing: 6px;
        Button { label: "Random All"; enabled: root.images || root.videos; clicked => { ParticleBulk.apply(root.preset, 1, false, root.images, root.videos); } }
        Button { label: "Random Selected"; enabled: root.images || root.videos; clicked => { ParticleBulk.apply(root.preset, 1, true, root.images, root.videos); } }
    }
    Button { label: "Favorites Randomly"; enabled: root.images || root.videos; clicked => { ParticleBulk.apply(root.preset, 2, false, root.images, root.videos); } }
}

// Left library: stable preset order matches Studio::apply_particle_bulk IDS.
export component ParticlePresetLibrary inherits VerticalLayout {
    property <[string]> names: [
        "White Twinkling Stars", "Golden Sparkles", "Orange Embers",
        "Fireflies", "Bokeh Lights", "Dust Motes", "Snow", "Rain", "Ash",
        "Light Leaks", "Shooting Stars", "Confetti"
    ];
    property <[string]> ids: [
        "stars", "gold-sparkles", "embers", "fireflies", "bokeh",
        "dust-motes", "snow", "rain", "ash", "light-leaks",
        "shooting-stars", "confetti"
    ];
    property <bool> favourites-only: false;
    property <int> category: 0;
    function inspect(index: int, name: string) {
        ParticleBulk.preset = index;
        LibraryFocus.page = 9;
        LibraryFocus.selected-id = "concat.particles-" + root.ids[index];
        LibraryFocus.selected-name = name;
        LibraryFocus.selected-category = index < 4 ? "Light"
            : index < 6 ? "Atmosphere" : index < 9 ? "Weather" : "Motion";
        LibraryFocus.selected-description = "Apply to selected or all compatible visual clips. Overlay parameters remain editable on the applied clip.";
    }
    // The backend publishes all twelve stable IDs in preset order.
    property <bool> has-starred:
        ParticleBulk.favourites.length >= 12 &&
        (ParticleBulk.favourites[0] || ParticleBulk.favourites[1] ||
         ParticleBulk.favourites[2] || ParticleBulk.favourites[3] ||
         ParticleBulk.favourites[4] || ParticleBulk.favourites[5] ||
         ParticleBulk.favourites[6] || ParticleBulk.favourites[7] ||
         ParticleBulk.favourites[8] || ParticleBulk.favourites[9] ||
         ParticleBulk.favourites[10] || ParticleBulk.favourites[11]);
    spacing: 8px;
    HorizontalLayout {
        spacing: 6px;
        Button {
            label: root.favourites-only ? "★ Favorites" : "☆ Favorites";
            clicked => { root.favourites-only = !root.favourites-only; }
        }
        Select {
            options: ["All", "Light", "Atmosphere", "Weather", "Motion"];
            current <=> root.category;
        }
    }
    if root.favourites-only && !root.has-starred: Text {
        text: "No starred particle presets. Turn off Favorites to browse all twelve.";
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    if root.favourites-only && root.has-starred: Text {
        text: "Only Favorites in the selected category are shown. Choose All to see every starred preset.";
        color: Theme.fg-muted;
        font-size: Theme.fs-xs;
        wrap: word-wrap;
    }
    for name[index] in root.names: Rectangle {
        property <int> group: index < 4 ? 1 : index < 6 ? 2 : index < 9 ? 3 : 4;
        visible: (root.category == 0 || root.category == self.group)
            && (!root.favourites-only ||
                (ParticleBulk.favourites.length > index && ParticleBulk.favourites[index]));
        height: self.visible ? 62px : 0px;
        border-radius: Theme.r;
        border-width: ParticleBulk.preset == index ? 2px : 1px;
        border-color: ParticleBulk.preset == index ? Theme.accent : Theme.line;
        background: Theme.field;
        Text {
            x: 10px;
            y: 7px;
            width: parent.width - 58px;
            height: 23px;
            text: name;
            color: Theme.fg;
            font-size: Theme.fs-sm;
            overflow: elide;
        }
        Text {
            x: 10px;
            y: 34px;
            width: parent.width - 58px;
            height: 18px;
            text: index < 4 ? "Light" : index < 6 ? "Atmosphere"
                : index < 9 ? "Weather" : "Motion";
            color: Theme.fg-muted;
            font-size: Theme.fs-xs;
        }
        touch := TouchArea {
            width: parent.width - 38px;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.inspect(index, name); }
        }
        IconButton {
            x: parent.width - self.width - 5px;
            y: 35px;
            glyph: Glyph.info;
            label: "Inspect " + name + " without applying";
            clicked => { root.inspect(index, name); }
        }
        IconButton {
            x: parent.width - self.width - 5px;
            y: 8px;
            glyph: Glyph.mask-star;
            checked: ParticleBulk.favourites.length > index && ParticleBulk.favourites[index];
            label: "Toggle favorite for " + name;
            clicked => { ParticleBulk.toggle-favourite(index); }
        }
    }
}
