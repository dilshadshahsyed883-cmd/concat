import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Check } from "../inspector/controls.slint";
export global CanvasPresets {
    in-out property <string> profile;
    callback choose(preset: int);
    callback apply(profile: string, all: bool, images: bool, videos: bool);
}
export component CanvasPresetPanel inherits VerticalLayout {
    in-out property <bool> images: true;
    in-out property <bool> videos: true;
    property <bool> advanced-open: false;
    spacing: 8px;
    Text { text: "Canvas Presets"; color: Theme.fg; font-size: Theme.fs; }
    HorizontalLayout {
        spacing: 8px;
        Check { checked: root.images; toggled(on) => { root.images = on; } }
        Text { text: "Images"; color: Theme.fg; vertical-alignment: center; }
        Check { checked: root.videos; toggled(on) => { root.videos = on; } }
        Text { text: "Video Clips"; color: Theme.fg; vertical-alignment: center; }
    }
    HorizontalLayout {
        Button { label: "Sports Frame"; clicked => { CanvasPresets.choose(1); } }
        Button { label: "Orange Frame"; clicked => { CanvasPresets.choose(2); } }
        Button { label: "Blurred Fill"; clicked => { CanvasPresets.choose(3); } }
    }
    Button {
        label: root.advanced-open ? "Hide Advanced JSON" : "Advanced JSON";
        clicked => { root.advanced-open = !root.advanced-open; }
    }
    if root.advanced-open: Rectangle {
        height: 220px; background: Theme.field; border-radius: Theme.r;
        TextInput { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            text <=> CanvasPresets.profile; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap; }
    }
    HorizontalLayout {
        Button { label: "Apply Selected"; enabled: root.images || root.videos; clicked => { CanvasPresets.apply(CanvasPresets.profile, false, root.images, root.videos); } }
        Button { label: "Apply All"; enabled: root.images || root.videos; clicked => { CanvasPresets.apply(CanvasPresets.profile, true, root.images, root.videos); } }
    }
}
