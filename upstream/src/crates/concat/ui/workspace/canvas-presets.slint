import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Check } from "../inspector/controls.slint";
export global CanvasPresets {
    in-out property <string> profile;
    /// True for legacy preset IDs 1, 2, 3; sourced from saved app preferences.
    in property <[bool]> favourites;
    callback toggle-favourite(preset: int);
    callback choose(preset: int);
    callback apply(profile: string, all: bool, images: bool, videos: bool);
}
export component CanvasPresetPanel inherits VerticalLayout {
    in-out property <bool> images: true;
    in-out property <bool> videos: true;
    property <bool> advanced-open: false;
    property <bool> favourites-only: false;
    property <int> chosen: 1;
    spacing: 8px;
    Text { text: "Canvas Presets"; color: Theme.fg; font-size: Theme.fs; }
    HorizontalLayout {
        spacing: 8px;
        Check { checked: root.images; toggled(on) => { root.images = on; } }
        Text { text: "Images"; color: Theme.fg; vertical-alignment: center; }
        Check { checked: root.videos; toggled(on) => { root.videos = on; } }
        Text { text: "Video Clips"; color: Theme.fg; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 8px;
        Button {
            label: root.favourites-only ? "All" : "✓ All";
            clicked => { root.favourites-only = false; }
        }
        Button {
            label: root.favourites-only ? "✓ Favorites" : "Favorites";
            clicked => { root.favourites-only = true; }
        }
    }
    if !root.favourites-only || CanvasPresets.favourites[0]: HorizontalLayout {
        spacing: 8px;
        Button {
            horizontal-stretch: 1;
            label: root.chosen == 1 ? "✓ Sports Frame" : "Sports Frame";
            clicked => { root.chosen = 1; CanvasPresets.choose(1); }
        }
        Button {
            label: CanvasPresets.favourites[0] ? "★" : "☆";
            clicked => { CanvasPresets.toggle-favourite(1); }
        }
    }
    if !root.favourites-only || CanvasPresets.favourites[1]: HorizontalLayout {
        spacing: 8px;
        Button {
            horizontal-stretch: 1;
            label: root.chosen == 2 ? "✓ Orange Frame" : "Orange Frame";
            clicked => { root.chosen = 2; CanvasPresets.choose(2); }
        }
        Button {
            label: CanvasPresets.favourites[1] ? "★" : "☆";
            clicked => { CanvasPresets.toggle-favourite(2); }
        }
    }
    if !root.favourites-only || CanvasPresets.favourites[2]: HorizontalLayout {
        spacing: 8px;
        Button {
            horizontal-stretch: 1;
            label: root.chosen == 3 ? "✓ Blurred Fill" : "Blurred Fill";
            clicked => { root.chosen = 3; CanvasPresets.choose(3); }
        }
        Button {
            label: CanvasPresets.favourites[2] ? "★" : "☆";
            clicked => { CanvasPresets.toggle-favourite(3); }
        }
    }
    if root.favourites-only && !CanvasPresets.favourites[0] && !CanvasPresets.favourites[1] && !CanvasPresets.favourites[2]: Text {
        text: "No favorite Canvas Presets yet. Star a preset in All.";
        color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
    }
    Button {
        label: root.advanced-open ? "Hide Advanced JSON" : "Advanced JSON";
        clicked => { root.advanced-open = !root.advanced-open; }
    }
    if root.advanced-open: Rectangle {
        height: 220px; background: Theme.field; border-radius: Theme.r;
        TextInput { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            text <=> CanvasPresets.profile; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap; }
    }
    HorizontalLayout {
        Button { label: "Apply Selected"; enabled: root.images || root.videos; clicked => { CanvasPresets.apply(CanvasPresets.profile, false, root.images, root.videos); } }
        Button { label: "Apply All"; enabled: root.images || root.videos; clicked => { CanvasPresets.apply(CanvasPresets.profile, true, root.images, root.videos); } }
    }
}
