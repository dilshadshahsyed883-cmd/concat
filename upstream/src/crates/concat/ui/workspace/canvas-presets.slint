import { Theme } from "../theme/theme.slint";
import { Select } from "../primitives/select.slint";
import { ColourField, Param, ParamFormat } from "../inspector/controls.slint";
import { Button } from "../primitives/modal.slint";
import { IconButton } from "../primitives/panel.slint";
import { Glyph } from "../icons.slint";
import { LibraryFocus } from "library-focus.slint";
import { Keyframes } from "../timeline/model.slint";
export global CanvasPresets {
    in-out property <int> selected: 1;
    in property <[bool]> favourites;
    callback edit-number(field: string, value: float);
    callback edit-colour(field: string, value: color);
    callback edit-mode(mode: int);
    callback sync-profile();
    callback toggle-favourite(index: int);
    in property <float> foreground-x: 0.04;
    in property <float> foreground-y: 0.035;
    in property <float> foreground-width: 0.92;
    in property <float> foreground-height: 0.80;
    /// Percent of this preset's baseline picture opening, not source zoom.
    in property <float> foreground-size: 120;
    in property <float> border-width: 0.006;
    in property <float> radius: 0;
    in property <float> blur: 0;
    in property <float> pattern-intensity: 0.5;
    in property <float> pattern-density: 0.5;
    in property <float> pattern-size: 0.5;
    in property <float> lighting-spread: 0.5;
    in property <float> pattern-opacity: 1;
    in property <float> tint-opacity: 0;
    in property <float> shadow-opacity: 0;
    in property <float> shadow-offset: 0;
    in property <float> mat-bottom: 0;
    in property <float> rotation: 0;
    in property <float> derivative-opacity: 0.22;
    in property <int> bleed-edge: 0;
    in property <int> background-mode: 0;
    in property <color> border-color: #ff153a;
    in property <color> background-color: #000000;
    in property <color> tint-color: #000000;
    in property <color> shadow-color: #000000;
    in property <color> mat-color: #ffffff;
    in-out property <string> profile;
    callback choose(preset: int);
    callback apply(profile: string, all: bool, images: bool, videos: bool);
    callback random-favourites(images: bool, videos: bool, selected: bool);
    callback clear(selected: bool, images: bool, videos: bool);
    callback save-default(profile: string);
    callback reset-default();
    in-out property <string> default-status;
}
export component CanvasPresetPanel inherits VerticalLayout {
    in property <bool> images: true;
    in property <bool> videos: true;
    property <bool> advanced-open: false;
    spacing: 8px;
    Text { text: "Preset settings"; color: Theme.fg; font-size: Theme.fs; font-weight: Theme.weight-title; }
    Text {
        text: CanvasPresets.selected == 1 ? "Sports Frame"
            : CanvasPresets.selected == 2 ? "Orange Frame"
            : CanvasPresets.selected == 3 ? "Adaptive Blur (Blurred Fill)"
            : CanvasPresets.selected == 4 ? "Gallery Mat"
            : CanvasPresets.selected == 5 ? "Floating Card"
            : CanvasPresets.selected == 6 ? "Photo Print"
            : CanvasPresets.selected == 9 ? "Broadcast Edge"
            : CanvasPresets.selected == 12 ? "Focus Island"
            : CanvasPresets.selected == 13 ? "Diagonal Cut"
            : CanvasPresets.selected == 14 ? "Projector Slide"
            : CanvasPresets.selected == 15 ? "Browser Window"
            : CanvasPresets.selected == 16 ? "Taped Memory"
            : CanvasPresets.selected == 18 ? "Broken Grid"
            : CanvasPresets.selected == 11 ? "Mirror Stage"
            : CanvasPresets.selected == 19 ? "Image Echo"
            : CanvasPresets.selected == 20 ? "Edge Bleed"
            : CanvasPresets.selected == 10 ? "Arch Window"
            : "Orbital Frame";
        color: Theme.fg-muted; font-size: Theme.fs-sm;
    }
    VerticalLayout {
        spacing: 7px;
        Text { text: "Picture Size changes the foreground opening and frame, not Content Zoom / Crop. Default target: 120%; safe canvas bounds may limit the actual size.";
            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap; }
        Param { label: "Picture Size"; value: CanvasPresets.foreground-size;
            minimum: 40; maximum: 130; step: 1; default-value: 120; unit: "%"; fmt: ParamFormat.percent;
            changed(v) => { CanvasPresets.edit-number("foregroundSize", v); } }
        Param { label: "Left"; value: CanvasPresets.foreground-x; minimum: 0; maximum: 1 - CanvasPresets.foreground-width; step: 0.005; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundX", v); } }
        Param { label: "Top"; value: CanvasPresets.foreground-y; minimum: 0; maximum: 1 - CanvasPresets.foreground-height; step: 0.005; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundY", v); } }
        Param { label: "Width"; value: CanvasPresets.foreground-width; minimum: 0.05; maximum: 1 - CanvasPresets.foreground-x; step: 0.005; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundWidth", v); } }
        Param { label: "Height"; value: CanvasPresets.foreground-height; minimum: 0.05; maximum: 1 - CanvasPresets.foreground-y; step: 0.005; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundHeight", v); } }
        Param { label: "Border thickness"; value: CanvasPresets.border-width; minimum: 0; maximum: 0.1; step: 0.001; unit: "%"; unit-scale: 100; fmt: ParamFormat.outline; changed(v) => { CanvasPresets.edit-number("borderWidth", v); } }
        ColourField { label: "Border color"; value: CanvasPresets.border-color; changed(c) => { CanvasPresets.edit-colour("borderColor", c); } }
        if CanvasPresets.selected != 10 && CanvasPresets.selected != 17: Param { label: "Corner radius"; value: CanvasPresets.radius; minimum: 0; maximum: 0.5; step: 0.005; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("radius", v); } }
        Text { text: "Background"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        Select {
            options: ["Source", "Blurred source", "Solid color", "None", "Adaptive Colors", "Ambient Color Clouds", "Frosted Glass Panels", "Radial Spotlight", "Halftone Arena", "Diagonal Light Streaks", "Monochrome Backdrop", "Topographic Waves", "Carbon Fiber", "Prism Refraction", "Cinematic Bokeh", "Textured Paper", "Light Tunnel"];
            current: CanvasPresets.background-mode;
            changed(index) => { CanvasPresets.edit-mode(index); }
        }
        if CanvasPresets.background-mode == 1: Param {
            label: "Blur softness"; value: CanvasPresets.blur; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction;
            changed(v) => { CanvasPresets.edit-number("blur", v); }
        }
        if CanvasPresets.background-mode == 4: Text {
            text: "Extract dominant colors from the original media once. Video colors stay stable during playback.";
            color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
        }
        if CanvasPresets.background-mode == 2 || CanvasPresets.background-mode >= 5: ColourField {
            label: "Background color"; value: CanvasPresets.background-color;
            changed(c) => { CanvasPresets.edit-colour("backgroundColor", c); }
        }
        if CanvasPresets.background-mode >= 5: VerticalLayout {
            spacing: 5px;
            if CanvasPresets.background-mode != 10: ColourField { label: "Accent color"; value: CanvasPresets.tint-color; changed(c) => { CanvasPresets.edit-colour("backgroundTint", c); } }
            Param { label: "Intensity"; value: CanvasPresets.pattern-intensity; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("patternIntensity", v); } }
            Param { label: "Opacity"; value: CanvasPresets.pattern-opacity; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("patternOpacity", v); } }
            if CanvasPresets.background-mode == 8 || CanvasPresets.background-mode == 9 || CanvasPresets.background-mode >= 11: Param { label: "Texture density"; value: CanvasPresets.pattern-density; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("patternDensity", v); } }
            if CanvasPresets.background-mode == 8 || CanvasPresets.background-mode == 9 || CanvasPresets.background-mode >= 11: Param { label: "Pattern size"; value: CanvasPresets.pattern-size; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("patternSize", v); } }
            if CanvasPresets.background-mode == 5 || CanvasPresets.background-mode == 7 || CanvasPresets.background-mode == 9 || CanvasPresets.background-mode == 14 || CanvasPresets.background-mode == 16: Param { label: "Lighting spread"; value: CanvasPresets.lighting-spread; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("lightingSpread", v); } }
            if CanvasPresets.background-mode == 6 || CanvasPresets.background-mode == 8 || CanvasPresets.background-mode == 11 || CanvasPresets.background-mode == 14 || CanvasPresets.background-mode == 16: Param { label: "Blur softness"; value: CanvasPresets.blur; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("blur", v); } }
        }
        if CanvasPresets.background-mode < 5: ColourField { label: "Background tint"; value: CanvasPresets.tint-color; changed(c) => { CanvasPresets.edit-colour("backgroundTint", c); } }
        if CanvasPresets.background-mode < 5: Param { label: "Tint opacity"; value: CanvasPresets.tint-opacity; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("tintOpacity", v); } }
        Param { label: "Shadow opacity"; value: CanvasPresets.shadow-opacity; minimum: 0; maximum: 1; step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("shadowOpacity", v); } }
        if CanvasPresets.shadow-opacity > 0: VerticalLayout {
            spacing: 4px;
            Param { label: "Shadow offset"; value: CanvasPresets.shadow-offset; minimum: 0; maximum: 0.08; step: 0.001; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("shadowOffset", v); } }
            ColourField { label: "Shadow color"; value: CanvasPresets.shadow-color; changed(c) => { CanvasPresets.edit-colour("shadowColor", c); } }
        }
        if CanvasPresets.selected == 6: VerticalLayout {
            spacing: 4px;
            Param { label: "Print bottom mat"; value: CanvasPresets.mat-bottom; minimum: 0; maximum: 0.2; step: 0.005; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("matBottom", v); } }
            ColourField { label: "Print mat color"; value: CanvasPresets.mat-color; changed(c) => { CanvasPresets.edit-colour("matColor", c); } }
        }
        if CanvasPresets.selected == 14: ColourField {
            label: "Projector mount color"; value: CanvasPresets.mat-color;
            changed(c) => { CanvasPresets.edit-colour("matColor", c); }
        }
        if CanvasPresets.selected == 11 || CanvasPresets.selected == 19: Param {
            label: CanvasPresets.selected == 11 ? "Reflection opacity" : "Echo opacity";
            value: CanvasPresets.derivative-opacity; minimum: 0; maximum: 1;
            step: 0.01; unit: "%"; unit-scale: 100; fmt: ParamFormat.fraction;
            changed(v) => { CanvasPresets.edit-number("derivativeOpacity", v); }
        }
        if CanvasPresets.selected == 20: VerticalLayout {
            spacing: 4px;
            Text { text: "Bleed edge"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
            Select {
                options: ["Left", "Right", "Top", "Bottom"];
                current: CanvasPresets.bleed-edge;
                changed(index) => { CanvasPresets.edit-number("bleedEdge", index); }
            }
        }
        if CanvasPresets.selected >= 4: Param {
            label: "Rotation"; value: CanvasPresets.rotation; minimum: -12; maximum: 12; step: 1; unit: "°"; fmt: ParamFormat.degrees;
            changed(v) => { CanvasPresets.edit-number("rotation", v); }
        }
    }
    Button {
        label: root.advanced-open ? "Hide Advanced JSON" : "Advanced JSON";
        clicked => {
            if (root.advanced-open) { CanvasPresets.sync-profile(); }
            root.advanced-open = !root.advanced-open;
        }
    }
    if root.advanced-open: Rectangle {
        height: 220px; background: Theme.field; border-radius: Theme.r;
        TextInput {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            text <=> CanvasPresets.profile; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Button { label: "Save as Default"; clicked => { CanvasPresets.save-default(CanvasPresets.profile); } }
        Button { label: "Reset Default"; clicked => { CanvasPresets.reset-default(); } }
    }
    if CanvasPresets.default-status != "": Text {
        text: CanvasPresets.default-status;
        color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
    }
}

// Kept outside the inspector scroller so Apply stays visible at small window
// heights and 100/125/150% Windows display scaling.
export component CanvasPresetApplyBar inherits VerticalLayout {
    in property <bool> images: true;
    in property <bool> videos: true;
    spacing: 5px;
    padding: 8px;
    Button { label: "Apply Selected"; enabled: root.images || root.videos; clicked => { CanvasPresets.apply(CanvasPresets.profile, false, root.images, root.videos); } }
    Button { label: "Apply All"; enabled: root.images || root.videos; clicked => { CanvasPresets.apply(CanvasPresets.profile, true, root.images, root.videos); } }
    Button { label: "Apply Favorites Randomly"; enabled: root.images || root.videos;
        clicked => { CanvasPresets.random-favourites(root.images,root.videos,Keyframes.animation-scope == 1); } }
}

export component CanvasPresetClearBar inherits VerticalLayout {
    in property <bool> images: true;
    in property <bool> videos: true;
    vertical-stretch: 0;
    spacing: 6px;
    padding: 8px;
    Button {
        label: "Clear Selected Canvas Presets";
        enabled: root.images || root.videos;
        clicked => { CanvasPresets.clear(true, root.images, root.videos); }
    }
    Button {
        label: "Clear All Eligible Canvas Presets";
        enabled: root.images || root.videos;
        clicked => { CanvasPresets.clear(false, root.images, root.videos); }
    }
}

export component CanvasPresetLibrary inherits VerticalLayout {
    property <[string]> names: ["Sports Frame", "Adaptive Blur (Blurred Fill)", "Gallery Mat", "Floating Card", "Photo Print", "Diagonal Cut", "Browser Window", "Taped Memory", "Broken Grid", "Arch Window", "Orbital Frame"];
    // Catalogue position is NOT the persistent ID. Retired IDs are never listed.
    property <[int]> ids: [1, 3, 4, 5, 6, 13, 15, 16, 18, 10, 17];
    property <bool> favourites-only: false;
    // Dense positions in the Favorites view, following AnimationFavoriteCards.
    pure function is-starred(index: int) -> bool {
        return index < CanvasPresets.favourites.length && CanvasPresets.favourites[index];
    }
    pure function count-eight(start: int, before: int) -> int {
        return (start + 0 < before && root.is-starred(start + 0) ? 1 : 0)
            + (start + 1 < before && root.is-starred(start + 1) ? 1 : 0)
            + (start + 2 < before && root.is-starred(start + 2) ? 1 : 0)
            + (start + 3 < before && root.is-starred(start + 3) ? 1 : 0)
            + (start + 4 < before && root.is-starred(start + 4) ? 1 : 0)
            + (start + 5 < before && root.is-starred(start + 5) ? 1 : 0)
            + (start + 6 < before && root.is-starred(start + 6) ? 1 : 0)
            + (start + 7 < before && root.is-starred(start + 7) ? 1 : 0);
    }
    pure function favourite-rank(before: int) -> int {
        return root.count-eight(0, before)
            + root.count-eight(8, before)
            + root.count-eight(16, before);
    }
    property <int> visible-count: root.favourites-only ? root.favourite-rank(root.names.length) : root.names.length;
    function inspect(index: int, name: string) {
        CanvasPresets.selected = root.ids[index];
        CanvasPresets.choose(root.ids[index]);
        LibraryFocus.page = 8;
        LibraryFocus.selected-id = "concat.canvas-\{root.ids[index]}";
        LibraryFocus.selected-name = name;
        LibraryFocus.selected-category = "Canvas Preset";
        LibraryFocus.selected-description = "Configure framing and target scope in the right inspector. Browsing does not apply a preset.";
    }
    spacing: 8px;
    Button {
        label: root.favourites-only ? "★ Favorites" : "☆ Favorites";
        clicked => { root.favourites-only = !root.favourites-only; }
    }
    Button {
        label: CanvasPresets.selected == 0 ? "✓ None / No Canvas Preset" : "None / No Canvas Preset";
        clicked => {
            CanvasPresets.selected = 0;
            LibraryFocus.page = 8;
            LibraryFocus.selected-id = "__none_canvas_preset__";
            LibraryFocus.selected-name = "";
            LibraryFocus.selected-category = "";
            LibraryFocus.selected-description = "";
        }
    }
    if root.favourites-only && root.visible-count == 0: Text {
        text: "No starred Canvas presets. Turn off Favorites to browse all presets.";
        color: Theme.fg-muted;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
    grid := Rectangle {
        property <length> gap: 8px;
        property <length> min-card: 260px;
        property <length> card-h: 62px;
        property <int> cols: Math.max(1, Math.floor((self.width + self.gap) / (self.min-card + self.gap)));
        property <length> card-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
        property <int> rows: Math.ceil(root.visible-count / self.cols);
        visible: root.visible-count > 0;
        height: self.rows > 0 ? self.rows * (self.card-h + self.gap) - self.gap : 0px;
        vertical-stretch: 0;
        clip: true;
        for name[index] in root.names: Rectangle {
            property <int> compact-index: root.favourites-only ? root.favourite-rank(index) : index;
            visible: !root.favourites-only || root.is-starred(index);
            x: Math.mod(self.compact-index, grid.cols) * (grid.card-w + grid.gap);
            y: Math.floor(self.compact-index / grid.cols) * (grid.card-h + grid.gap);
            width: grid.card-w;
            height: grid.card-h;
            clip: true;
            border-width: CanvasPresets.selected == root.ids[index] ? 2px : 1px;
            border-color: CanvasPresets.selected == root.ids[index] ? Theme.accent : Theme.line;
            border-radius: Theme.r;
            background: Theme.field;
            // Schematic previews show composition, never a second media source.
            Rectangle {
                x: 7px; y: 8px; width: 54px; height: 46px;
                border-radius: Theme.r;
                background: root.ids[index] == 1 ? #b51c3e
                    : root.ids[index] == 2 ? #f49a4b
                    : root.ids[index] == 4 ? #e4e0d6
                    : root.ids[index] == 5 ? #152336
                    : root.ids[index] == 6 ? #25303a
                    : root.ids[index] == 9 ? #19395b
                    : root.ids[index] == 12 ? #172337
                    : root.ids[index] == 13 ? #943c56
                    : root.ids[index] == 14 ? #ddd2b9
                    : root.ids[index] == 15 ? #34465e
                    : root.ids[index] == 16 ? #d6c5aa
                    : root.ids[index] == 18 ? #355f61
                    : root.ids[index] == 11 ? #111923
                    : root.ids[index] == 19 ? #142135
                    : root.ids[index] == 20 ? #192a3e
                    : root.ids[index] == 10 ? #d4c3a7
                    : root.ids[index] == 17 ? #101e35 : #596e8f;
                if root.ids[index] == 17: Rectangle { x: 7px; y: 3px; width: 40px; height: 40px; border-radius: 20px; background: #466c9b; }
                if root.ids[index] == 17: Rectangle { x: 10px; y: 6px; width: 34px; height: 34px; border-radius: 17px; background: #101e35; }
                if root.ids[index] == 10: Rectangle { x: 13px; y: 4px; width: 28px; height: 28px; border-radius: 14px; background: #8899ac; }
                if root.ids[index] == 10: Rectangle { x: 13px; y: 18px; width: 28px; height: 24px; background: #8899ac; }
                if root.ids[index] == 11: Rectangle { x: 9px; y: 33px; width: 36px; height: 8px; background: #465466; }
                if root.ids[index] == 19: Rectangle { x: 3px; y: 4px; width: 41px; height: 38px; background: #506785; }
                if root.ids[index] == 19: Rectangle { x: 12px; y: 5px; width: 40px; height: 35px; background: #415774; }
                if root.ids[index] == 9: Rectangle { x: 2px; y: 4px; width: 4px; height: 36px; background: #f33748; }
                if root.ids[index] == 13: Rectangle { x: 3px; y: 0px; width: 12px; height: 46px; background: #263d66; }
                if root.ids[index] == 14: Rectangle { x: 4px; y: 3px; width: 46px; height: 40px; background: #ddd2b9; border-width: 2px; border-color: #514638; }
                if root.ids[index] == 15: Rectangle { x: 6px; y: 3px; width: 42px; height: 7px; background: #d9e2ee; }
                if root.ids[index] == 18: Rectangle { x: 35px; y: 28px; width: 17px; height: 16px; background: #c67c51; }
                Rectangle {
                    visible: root.ids[index] != 10;
                    x: root.ids[index] == 20 ? 0px : root.ids[index] == 17 ? 13px : 8px;
                    y: root.ids[index] == 6 ? 5px : root.ids[index] == 15 ? 11px : root.ids[index] == 11 ? 4px : root.ids[index] == 17 ? 9px : 7px;
                    width: root.ids[index] == 17 ? 28px : 38px;
                    height: root.ids[index] == 17 ? 28px : root.ids[index] == 11 ? 27px : root.ids[index] == 6 || root.ids[index] == 15 ? 29px : 32px;
                    background: #8899ac;
                    border-radius: root.ids[index] == 17 ? 14px : root.ids[index] == 5 || root.ids[index] == 12 ? 5px : 1px;
                    border-width: root.ids[index] == 1 || root.ids[index] == 2 || root.ids[index] == 16 ? 2px : 0px;
                    border-color: root.ids[index] == 1 ? #ff153a : root.ids[index] == 16 ? #fff9ed : #ff914d;
                }
                if root.ids[index] == 16: Rectangle { x: 7px; y: 5px; width: 15px; height: 5px; background: #f4e1ad; }
                if root.ids[index] == 16: Rectangle { x: 32px; y: 5px; width: 15px; height: 5px; background: #f4e1ad; }
            }
            Text {
                x: 70px;
                y: 8px;
                width: Math.max(0px, parent.width - 112px);
                overflow: elide;
                text: name;
                color: Theme.fg;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
            }
            Text {
                x: 70px;
                y: 33px;
                width: Math.max(0px, parent.width - 112px);
                overflow: elide;
                text: root.ids[index] == 1 ? "Legacy sports style"
                    : root.ids[index] == 2 ? "Legacy orange style"
                    : root.ids[index] == 3 ? "Same-source blur"
                    : root.ids[index] == 4 ? "Balanced picture mat"
                    : root.ids[index] == 5 ? "Rounded elevated card"
                    : root.ids[index] == 6 ? "Tilted photo mat"
                    : root.ids[index] == 9 ? "Asymmetric broadcast panels"
                    : root.ids[index] == 12 ? "Dark same-source backdrop"
                    : root.ids[index] == 13 ? "Angled graphic edges"
                    : root.ids[index] == 14 ? "Mounted transparency"
                    : root.ids[index] == 15 ? "Digital window frame"
                    : root.ids[index] == 16 ? "Decorative photo tape"
                    : root.ids[index] == 18 ? "Staggered background blocks"
                    : root.ids[index] == 11 ? "Same-source floor reflection"
                    : root.ids[index] == 19 ? "Enlarged source echoes"
                    : root.ids[index] == 20 ? "Edge-aligned picture"
                    : root.ids[index] == 10 ? "Rounded-top arch opening"
                    : "Circular opening and rings";
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
            }
            TouchArea {
                x: 0;
                y: 0;
                width: Math.max(0px, parent.width - 38px);
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.inspect(index, name); }
            }
            IconButton {
                x: parent.width - self.width - 5px;
                y: 35px;
                glyph: Glyph.info;
                label: "Inspect " + name + " without applying";
                clicked => { root.inspect(index, name); }
            }
            IconButton {
                x: parent.width - self.width - 5px;
                y: 8px;
                glyph: Glyph.mask-star;
                checked: CanvasPresets.favourites.length > index && CanvasPresets.favourites[index];
                label: "Toggle favorite for " + name;
                clicked => { CanvasPresets.toggle-favourite(root.ids[index]); }
            }
        }
    }
}
