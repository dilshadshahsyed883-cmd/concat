import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { Check, ColourField, Param, ParamFormat } from "../inspector/controls.slint";

// Stable native preset IDs. 1 and 2 are legacy color styles; 3 is the existing
// Blurred Fill / Adaptive Blur family. The five new compositions use IDs 4..8.
export global CanvasPresets {
    in-out property <string> profile;
    in property <[bool]> favourites;
    in-out property <int> selected: 1;
    in property <float> foreground-x: 0.04;
    in property <float> foreground-y: 0.035;
    in property <float> foreground-width: 0.92;
    in property <float> foreground-height: 0.80;
    in property <float> border-width: 0.006;
    in property <float> radius: 0;
    in property <float> blur: 0;
    in property <float> tint-opacity: 0;
    in property <float> shadow-opacity: 0;
    in property <float> shadow-offset: 0;
    in property <float> mat-bottom: 0;
    in property <float> rotation: 0;
    in property <int> background-mode: 0;
    in property <color> border-color: #ff153a;
    in property <color> background-color: #000000;
    in property <color> tint-color: #000000;
    in property <color> shadow-color: #000000;
    in property <color> mat-color: #ffffff;
    callback toggle-favourite(preset: int);
    callback choose(preset: int);
    callback edit-number(field: string, value: float);
    callback edit-colour(field: string, value: color);
    callback edit-mode(mode: int);
    callback sync-profile();
    callback apply(profile: string, all: bool, images: bool, videos: bool);
}

export component CanvasPresetPanel inherits VerticalLayout {
    in-out property <bool> images: true;
    in-out property <bool> videos: true;
    property <bool> advanced-open: false;
    property <bool> favourites-only: false;
    padding: 8px;
    spacing: 8px;

    Text { text: "Canvas Presets"; color: Theme.fg; font-size: Theme.fs-lg; font-weight: Theme.weight-title; }
    HorizontalLayout {
        spacing: 8px;
        Check { checked: root.images; toggled(on) => { root.images = on; } }
        Text { text: "Images"; color: Theme.fg; vertical-alignment: center; }
        Check { checked: root.videos; toggled(on) => { root.videos = on; } }
        Text { text: "Video Clips"; color: Theme.fg; vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 8px;
        Button {
            label: root.favourites-only ? "All" : "✓ All";
            clicked => { root.favourites-only = false; }
        }
        Button {
            label: root.favourites-only ? "✓ Favorites" : "Favorites";
            clicked => { root.favourites-only = true; }
        }
    }

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            width: 215px;
            spacing: 4px;
            if !root.favourites-only || CanvasPresets.favourites[0]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #b51c3e;
                        border-radius: 3px;
                        Rectangle {
                            x: 7px;
                            y: 4px;
                            width: 40px;
                            height: 28px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 2px;
                            border-color: #ff153a;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 1 ? "✓ Sports Frame" : "Sports Frame";
                        clicked => { CanvasPresets.choose(1); }
                    }
                    Button {
                        label: CanvasPresets.favourites[0] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(1); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[1]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #f49a4b;
                        border-radius: 3px;
                        Rectangle {
                            x: 7px;
                            y: 4px;
                            width: 40px;
                            height: 28px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 2px;
                            border-color: #ff914d;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 2 ? "✓ Orange Frame" : "Orange Frame";
                        clicked => { CanvasPresets.choose(2); }
                    }
                    Button {
                        label: CanvasPresets.favourites[1] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(2); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[2]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #596e8f;
                        border-radius: 3px;
                        Rectangle {
                            x: 7px;
                            y: 4px;
                            width: 40px;
                            height: 28px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 0px;
                            border-color: #ffffff;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 3 ? "✓ Adaptive Blur" : "Adaptive Blur";
                        clicked => { CanvasPresets.choose(3); }
                    }
                    Button {
                        label: CanvasPresets.favourites[2] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(3); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[3]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #e4e0d6;
                        border-radius: 3px;
                        Rectangle {
                            x: 7px;
                            y: 6px;
                            width: 40px;
                            height: 24px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 2px;
                            border-color: #ffffff;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 4 ? "✓ Gallery Mat" : "Gallery Mat";
                        clicked => { CanvasPresets.choose(4); }
                    }
                    Button {
                        label: CanvasPresets.favourites[3] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(4); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[4]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #152336;
                        border-radius: 3px;
                        Rectangle {
                            x: 7px;
                            y: 4px;
                            width: 40px;
                            height: 28px;
                            background: #8899ac;
                            border-radius: 5px;
                            border-width: 0px;
                            border-color: #ffffff;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 5 ? "✓ Floating Card" : "Floating Card";
                        clicked => { CanvasPresets.choose(5); }
                    }
                    Button {
                        label: CanvasPresets.favourites[4] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(5); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[5]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #25303a;
                        border-radius: 3px;
                        Rectangle {
                            x: 8px;
                            y: 5px;
                            width: 38px;
                            height: 24px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 2px;
                            border-color: #ffffff;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 6 ? "✓ Photo Print" : "Photo Print";
                        clicked => { CanvasPresets.choose(6); }
                    }
                    Button {
                        label: CanvasPresets.favourites[5] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(6); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[6]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #050505;
                        border-radius: 3px;
                        Rectangle {
                            x: 3px;
                            y: 8px;
                            width: 48px;
                            height: 20px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 0px;
                            border-color: #ffffff;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 7 ? "✓ Cinema Frame" : "Cinema Frame";
                        clicked => { CanvasPresets.choose(7); }
                    }
                    Button {
                        label: CanvasPresets.favourites[6] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(7); }
                    }
                }
            }
            if !root.favourites-only || CanvasPresets.favourites[7]: Rectangle {
                height: 46px;
                HorizontalLayout {
                    spacing: 4px;
                    // Schematic canvas composition preview, not an external image.
                    Rectangle {
                        width: 54px; height: 36px;
                        background: #f1e7dc;
                        border-radius: 3px;
                        Rectangle {
                            x: 20px;
                            y: 4px;
                            width: 29px;
                            height: 28px;
                            background: #8899ac;
                            border-radius: 1px;
                            border-width: 0px;
                            border-color: #ffffff;
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        label: CanvasPresets.selected == 8 ? "✓ Editorial Panel" : "Editorial Panel";
                        clicked => { CanvasPresets.choose(8); }
                    }
                    Button {
                        label: CanvasPresets.favourites[7] ? "★" : "☆";
                        clicked => { CanvasPresets.toggle-favourite(8); }
                    }
                }
            }
            if root.favourites-only
                && !CanvasPresets.favourites[0] && !CanvasPresets.favourites[1]
                && !CanvasPresets.favourites[2] && !CanvasPresets.favourites[3]
                && !CanvasPresets.favourites[4] && !CanvasPresets.favourites[5]
                && !CanvasPresets.favourites[6] && !CanvasPresets.favourites[7]: Text {
                text: "No favorites yet. Star one in All.";
                color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 7px;
            Text { text: "Preset settings"; color: Theme.fg; font-size: Theme.fs; font-weight: Theme.weight-title; }
            Param { label: "Left"; value: CanvasPresets.foreground-x; minimum: 0; maximum: 1 - CanvasPresets.foreground-width; step: 0.005; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundX", v); } }
            Param { label: "Top"; value: CanvasPresets.foreground-y; minimum: 0; maximum: 1 - CanvasPresets.foreground-height; step: 0.005; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundY", v); } }
            Param { label: "Width"; value: CanvasPresets.foreground-width; minimum: 0.05; maximum: 1 - CanvasPresets.foreground-x; step: 0.005; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundWidth", v); } }
            Param { label: "Height"; value: CanvasPresets.foreground-height; minimum: 0.05; maximum: 1 - CanvasPresets.foreground-y; step: 0.005; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("foregroundHeight", v); } }
            Param { label: "Border thickness"; value: CanvasPresets.border-width; minimum: 0; maximum: 0.1; step: 0.001; fmt: ParamFormat.outline; changed(v) => { CanvasPresets.edit-number("borderWidth", v); } }
            ColourField { label: "Border color"; value: CanvasPresets.border-color; changed(c) => { CanvasPresets.edit-colour("borderColor", c); } }
            Param { label: "Corner radius"; value: CanvasPresets.radius; minimum: 0; maximum: 0.5; step: 0.005; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("radius", v); } }
            Text { text: "Background"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
            Select {
                options: ["Source", "Blurred source", "Solid color", "None"];
                current: CanvasPresets.background-mode;
                changed(index) => { CanvasPresets.edit-mode(index); }
            }
            if CanvasPresets.background-mode == 1: Param {
                label: "Blur softness"; value: CanvasPresets.blur; minimum: 0; maximum: 1; step: 0.01; fmt: ParamFormat.fraction;
                changed(v) => { CanvasPresets.edit-number("blur", v); }
            }
            if CanvasPresets.background-mode == 2: ColourField {
                label: "Background color"; value: CanvasPresets.background-color;
                changed(c) => { CanvasPresets.edit-colour("backgroundColor", c); }
            }
            ColourField { label: "Background tint"; value: CanvasPresets.tint-color; changed(c) => { CanvasPresets.edit-colour("backgroundTint", c); } }
            Param { label: "Tint opacity"; value: CanvasPresets.tint-opacity; minimum: 0; maximum: 1; step: 0.01; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("tintOpacity", v); } }
            Param { label: "Shadow opacity"; value: CanvasPresets.shadow-opacity; minimum: 0; maximum: 1; step: 0.01; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("shadowOpacity", v); } }
            if CanvasPresets.shadow-opacity > 0: VerticalLayout {
                spacing: 4px;
                Param { label: "Shadow offset"; value: CanvasPresets.shadow-offset; minimum: 0; maximum: 0.08; step: 0.001; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("shadowOffset", v); } }
                ColourField { label: "Shadow color"; value: CanvasPresets.shadow-color; changed(c) => { CanvasPresets.edit-colour("shadowColor", c); } }
            }
            if CanvasPresets.selected == 6: VerticalLayout {
                spacing: 4px;
                Param { label: "Print bottom mat"; value: CanvasPresets.mat-bottom; minimum: 0; maximum: 0.2; step: 0.005; fmt: ParamFormat.fraction; changed(v) => { CanvasPresets.edit-number("matBottom", v); } }
                ColourField { label: "Print mat color"; value: CanvasPresets.mat-color; changed(c) => { CanvasPresets.edit-colour("matColor", c); } }
            }
            if CanvasPresets.selected >= 4: Param {
                label: "Rotation"; value: CanvasPresets.rotation; minimum: -12; maximum: 12; step: 1; fmt: ParamFormat.degrees;
                changed(v) => { CanvasPresets.edit-number("rotation", v); }
            }
        }
    }

    Button {
        label: root.advanced-open ? "Hide Advanced JSON" : "Advanced JSON";
        clicked => { root.advanced-open = !root.advanced-open; }
    }
    if root.advanced-open: Rectangle {
        height: 220px; background: Theme.field; border-radius: Theme.r;
        TextInput {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            text <=> CanvasPresets.profile; color: Theme.fg; font-size: Theme.fs-sm; wrap: word-wrap;
            changed has-focus => { if !self.has-focus { CanvasPresets.sync-profile(); } }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Button {
            label: "Apply Selected"; enabled: root.images || root.videos;
            clicked => { CanvasPresets.apply(CanvasPresets.profile, false, root.images, root.videos); }
        }
        Button {
            label: "Apply All"; enabled: root.images || root.videos;
            clicked => { CanvasPresets.apply(CanvasPresets.profile, true, root.images, root.videos); }
        }
    }
}
