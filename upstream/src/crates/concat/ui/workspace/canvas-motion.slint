import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { Param, ParamFormat, Check } from "../inspector/controls.slint";
import { Keyframes, CanvasMotionData } from "../timeline/model.slint";
export component CanvasMotionPanel inherits VerticalLayout {
    in property <bool> images: true;
    in property <bool> videos: true;
    in property <bool> selected-only: false;
    in-out property <int> preset: 0;
    in property <bool> inspector-mode: false;
    property <CanvasMotionData> settings <=> Keyframes.canvas-motion;
    spacing: 8px;
    if !root.inspector-mode: Text { text: "Canvas Motion"; color: Theme.fg; font-size: Theme.fs; }
    if !root.inspector-mode: Select { options: ["Top-left to Center", "Top-right to Center", "Bottom-left to Center", "Bottom-right to Center", "Center Pop", "Zoom at Left", "Zoom at Center", "Zoom at Right", "Reverse to Corner", "Slide from Left", "Slide from Right", "Slide from Top", "Slide from Bottom", "Diagonal Fly-in", "Spring Settle", "Documentary Pan", "Fade and Scale", "Alternating Inset", "Breathing Loop", "In / Hold / Out", "Focus Journey"]; current <=> root.preset; }
    if !root.inspector-mode: Button { label: Keyframes.physics-favourites[9 + root.preset] ? "★ Favorite" : "☆ Favorite";
        clicked => { Keyframes.toggle-physics-favourite(9 + root.preset); } }
    if root.preset != 15 && root.preset != 18: Param { label: "Start Scale"; value <=> root.settings.start-scale; minimum: 0.05; maximum: 1; step: 0.01; fmt: ParamFormat.steps; }
    if root.preset != 15: Param { label: root.preset == 18 ? "Base Scale" : "End Scale"; value <=> root.settings.end-scale; minimum: 0.05; maximum: 1; step: 0.01; fmt: ParamFormat.steps; }
    if root.preset == 15: Text { text: "Documentary Pan uses fixed base scale 0.88 → 0.96 (adjustable via Strength)."; color: Theme.fg-muted; wrap: word-wrap; font-size: Theme.fs-sm; }
    if root.preset == 18: Text { text: "Breathing Loop repeats a gentle zoom and returns to Base Scale at the end of the clip."; color: Theme.fg-muted; wrap: word-wrap; font-size: Theme.fs-sm; }
    if root.preset != 19: Param { label: root.preset == 18 ? "Approx. Cycle (seconds)" : "Motion Duration (seconds)"; value <=> root.settings.duration; minimum: 0.05; maximum: 60; step: 0.1; fmt: ParamFormat.steps; }
    if root.preset == 19: Text { text: "Entry and exit are independent. Hold = 0 fills the clip until the exit; a positive Hold ends the animation earlier."; color: Theme.fg-muted; wrap: word-wrap; font-size: Theme.fs-sm; }
    if root.preset == 19: Param { label: "Entry (seconds)"; value <=> root.settings.entry-seconds; minimum: 0.05; maximum: 60; step: 0.05; fmt: ParamFormat.steps; }
    if root.preset == 19: Param { label: "Hold (0 = auto)"; value <=> root.settings.hold-seconds; minimum: 0; maximum: 60; step: 0.1; fmt: ParamFormat.steps; }
    if root.preset == 19: Param { label: "Exit (seconds)"; value <=> root.settings.exit-seconds; minimum: 0.05; maximum: 60; step: 0.05; fmt: ParamFormat.steps; }
    Param { label: "Delay (seconds)"; value <=> root.settings.delay; minimum: 0; maximum: 60; step: 0.1; fmt: ParamFormat.steps; }
    Param { label: "Speed"; value <=> root.settings.speed; minimum: 0.25; maximum: 3; step: 0.05; fmt: ParamFormat.steps; }
    Param { label: "Strength"; value <=> root.settings.strength; minimum: 0.1; maximum: 2; step: 0.05; fmt: ParamFormat.steps; }
    if root.preset == 14: Param { label: "Spring Intensity"; value <=> root.settings.intensity; minimum: 0.2; maximum: 2; step: 0.05; fmt: ParamFormat.steps; }
    Param { label: "Background Blur"; value <=> root.settings.blur; minimum: 0; maximum: 1; step: 0.05; fmt: ParamFormat.steps; }
    Param { label: "Foreground Corners"; value <=> root.settings.corner-radius; minimum: 0; maximum: 0.2; step: 0.005; fmt: ParamFormat.steps; }
    if root.preset == 20: Text { text: "Moves between Start, Middle and End points with an adjustable pause at Middle. Enable custom anchors to edit Start/End."; color: Theme.fg-muted; wrap: word-wrap; font-size: Theme.fs-sm; }
    if root.preset == 20: Param { label: "Middle X"; value <=> root.settings.focus-middle-x; minimum: -0.45; maximum: 0.45; step: 0.01; fmt: ParamFormat.steps; }
    if root.preset == 20: Param { label: "Middle Y"; value <=> root.settings.focus-middle-y; minimum: -0.45; maximum: 0.45; step: 0.01; fmt: ParamFormat.steps; }
    if root.preset == 20: Param { label: "Middle Hold (seconds)"; value <=> root.settings.focus-hold; minimum: 0; maximum: root.settings.duration * 0.8 / root.settings.speed; step: 0.1; fmt: ParamFormat.steps; }
    if root.preset == 17: Param { label: "Random Seed"; value: root.settings.seed; changed(v) => { root.settings.seed = Math.round(v); } minimum: 0; maximum: 65535; step: 1; fmt: ParamFormat.steps; }
    if root.settings.custom-anchors && root.preset != 18: Param { label: "Start X"; value <=> root.settings.start-x; minimum: -0.5; maximum: 0.5; step: 0.01; fmt: ParamFormat.steps; }
    if root.settings.custom-anchors && root.preset != 18: Param { label: "Start Y"; value <=> root.settings.start-y; minimum: -0.5; maximum: 0.5; step: 0.01; fmt: ParamFormat.steps; }
    if root.settings.custom-anchors && root.preset != 18: Param { label: "End X"; value <=> root.settings.end-x; minimum: -0.5; maximum: 0.5; step: 0.01; fmt: ParamFormat.steps; }
    if root.settings.custom-anchors && root.preset != 18: Param { label: "End Y"; value <=> root.settings.end-y; minimum: -0.5; maximum: 0.5; step: 0.01; fmt: ParamFormat.steps; }
    HorizontalLayout {
        if root.preset != 18: Check { checked: root.settings.reverse; toggled(on) => { root.settings.reverse = on; } }
        if root.preset != 18: Text { text: "Reverse"; color: Theme.fg; }
        if root.preset != 18: Check { checked: root.settings.custom-anchors; toggled(on) => { root.settings.custom-anchors = on; } }
        if root.preset != 18: Text { text: "Use custom X/Y anchors"; color: Theme.fg; }
    }
    if root.preset != 18: Select { options: ["Linear", "Smooth"]; current: root.settings.easing; changed(index) => { root.settings.easing = index; } }
    Button { label: "Apply Selected"; enabled: root.images || root.videos; clicked => { Keyframes.apply-canvas-motion(root.preset, 0, root.images, root.videos, true, root.settings); } }
    Button { label: "Apply All"; enabled: root.images || root.videos; clicked => { Keyframes.apply-canvas-motion(root.preset, 0, root.images, root.videos, false, root.settings); } }
    Button { label: "Apply Randomly"; enabled: root.images || root.videos; clicked => { Keyframes.apply-canvas-motion(root.preset, 2, root.images, root.videos, root.selected-only, root.settings); } }
    Button { label: "Apply Favorites Randomly"; enabled: root.images || root.videos; clicked => { Keyframes.apply-canvas-motion(root.preset, 3, root.images, root.videos, root.selected-only, root.settings); } }
}
