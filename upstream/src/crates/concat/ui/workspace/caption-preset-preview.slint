// Caption cards and pending preview controls. Pixel samples come from Titles.
import { Theme } from "../theme/theme.slint";
import { Fmt } from "../util.slint";
import { Select } from "../primitives/select.slint";
import { ColourField } from "../inspector/controls.slint";
import { Button } from "../primitives/modal.slint";

export struct CaptionPreviewCard { id: string, name: string, thumbnail: image }

export global CaptionPresetPreview {
    in property <[CaptionPreviewCard]> cards;
    in property <string> chosen;
    in property <string> applied;
    in property <string> status;
    in property <bool> previewing;
    in property <int> font-index;
    in property <string> text-hex;
    in property <string> background-hex;
    in property <bool> sample;
    in property <bool> demo-playing;
    in property <bool> can-apply-selected;
    in property <bool> can-apply-all;
    callback stage(id: string);
    callback cancel();
    callback apply(all: bool);
    callback demo-toggle();
    callback scope(active: bool);
    callback style-font(index: int);
    callback style-color(field: string, hex: string);
}

export component CaptionPresetPreviewPanel inherits VerticalLayout {
    in property <bool> library-only: false;
    in property <bool> inspector-only: false;
    spacing: 8px;
    if !root.library-only: Text {
        text: CaptionPresetPreview.chosen == "" ? "Select a caption look to preview it. Apply to All works before captions exist."
            : CaptionPresetPreview.status;
        color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
    }
    if !root.library-only && CaptionPresetPreview.chosen != "": VerticalLayout {
        spacing: 6px;
        Text { text: "Font"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        Select {
            options: ["Hanken Grotesk SemiBold", "Hanken Grotesk Bold", "Inter Black", "Inter Bold", "Montserrat ExtraBold", "Archivo Black", "Anton"];
            current: CaptionPresetPreview.font-index;
            changed(index) => { CaptionPresetPreview.style-font(index); }
        }
        ColourField {
            label: "Text color";
            value: Fmt.color-of(CaptionPresetPreview.text-hex, #ffffff);
            changed(c) => { CaptionPresetPreview.style-color("text", Fmt.hex-of(c, false)); }
        }
        ColourField {
            label: "Background color";
            value: Fmt.color-of(CaptionPresetPreview.background-hex, #000000);
            changed(c) => { CaptionPresetPreview.style-color("background", Fmt.hex-of(c, false)); }
        }
        Button {
            label: "Apply to All Captions";
            enabled: CaptionPresetPreview.can-apply-all;
            primary: true;
            clicked => { CaptionPresetPreview.apply(true); }
        }
        Text {
            text: "Sets the project preset and requests GPU captions, even if none exist yet.";
            color: Theme.fg-muted; font-size: Theme.fs-xs; wrap: word-wrap;
        }
        Button {
            label: "Apply to Selected Captions";
            enabled: CaptionPresetPreview.can-apply-selected;
            clicked => { CaptionPresetPreview.apply(false); }
        }
        if !CaptionPresetPreview.can-apply-selected: Text {
            text: "Select an existing caption clip to use Apply to Selected. Apply to All does not require one.";
            color: Theme.fg-muted; font-size: Theme.fs-xs; wrap: word-wrap;
        }
        if CaptionPresetPreview.sample: Button {
            label: CaptionPresetPreview.demo-playing ? "Pause Sample Demo" : "Play Sample Demo";
            clicked => { CaptionPresetPreview.demo-toggle(); }
        }
        if CaptionPresetPreview.previewing: Button {
            label: "Cancel Preview"; clicked => { CaptionPresetPreview.cancel(); }
        }
    }
    if !root.inspector-only && CaptionPresetPreview.cards.length == 0: Text {
        text: "No caption presets loaded. Preset browsing does not require a selected caption. Reopen this shelf after the preset library is ready.";
        color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
    }
    if !root.inspector-only: Rectangle {
        property <length> gap: 8px;
        property <length> min-card: 144px;
        property <int> cols: Math.max(1, Math.floor((self.width + self.gap) / (self.min-card + self.gap)));
        property <length> card-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
        property <length> card-h: self.card-w * 9 / 16 + 56px;
        height: Math.ceil(CaptionPresetPreview.cards.length / self.cols) * (self.card-h + self.gap);
        for card[index] in CaptionPresetPreview.cards: Rectangle {
            x: Math.mod(index, parent.cols) * (parent.card-w + parent.gap);
            y: Math.floor(index / parent.cols) * (parent.card-h + parent.gap);
            width: parent.card-w; height: parent.card-h;
            border-radius: Theme.r;
            border-width: CaptionPresetPreview.chosen == card.id ? 2px : 1px;
            border-color: CaptionPresetPreview.chosen == card.id ? Theme.accent : touch.has-hover ? Theme.line-strong : Theme.line;
            background: Theme.sample-ground;
            Image {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.width * 9 / 16 - 4px;
                source: card.thumbnail; image-fit: contain;
            }
            if CaptionPresetPreview.applied == card.id: Text {
                x: 6px; y: 6px; width: parent.width - 12px; height: 18px;
                text: "Applied"; color: Theme.accent; font-size: Theme.fs-xs;
                horizontal-alignment: right;
            }
            Text {
                x: 6px; y: parent.width * 9 / 16 + 2px;
                width: parent.width - 12px; height: 52px;
                text: card.name; color: Theme.fg; font-size: Theme.fs-sm;
                wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center;
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { CaptionPresetPreview.stage(card.id); } }
        }
    }
}

// No hit area: a staged caption never becomes a timeline selection box.
export component CaptionPreviewBadge inherits Rectangle {
    visible: CaptionPresetPreview.previewing;
    in property <length> available-width: 296px;
    width: Math.max(40px, Math.min(280px, root.available-width - 16px));
    height: message.preferred-height + 10px;
    background: Theme.scrim; border-radius: Theme.r-xs;
    message := Text {
        x: 6px; y: 5px; width: parent.width - 12px;
        text: CaptionPresetPreview.sample ? "Sample caption • demo timing • preview only" : "Caption preset preview • not applied";
        color: Theme.on-scrim; font-size: Theme.fs-xs; wrap: word-wrap;
    }
}
