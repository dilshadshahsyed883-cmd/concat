import { Theme } from "../theme/theme.slint";
import { Button } from "../primitives/modal.slint";
import { Keyframes } from "../timeline/model.slint";
export component AnimationApplyBar inherits VerticalLayout {
    property <bool> targets: Keyframes.animation-images || Keyframes.animation-videos;
    function apply(selected:bool,mode:int) {
        Keyframes.remember-current();
        if Keyframes.animation-favourites-browser {
            Keyframes.apply-animation-favourites(Keyframes.favourite-pool,Keyframes.animation-images,Keyframes.animation-videos,selected);
        } else if Keyframes.animation-selected < 9 {
            Keyframes.apply-physics-bulk(Keyframes.animation-selected,mode,Keyframes.animation-images,Keyframes.animation-videos,selected,
                Keyframes.physics-strength,Keyframes.physics-duration,Keyframes.physics-speed,Keyframes.physics-intensity,
                Keyframes.canvas-motion.auto-fit);
        } else {
            Keyframes.apply-canvas-motion(Keyframes.animation-selected - 9,mode,Keyframes.animation-images,Keyframes.animation-videos,selected,Keyframes.canvas-motion);
        }
    }
    padding: 8px; spacing: 6px;
    if Keyframes.animation-favourites-browser: Text {
        text: "Check favorite cards to choose the pool. Each target receives one chosen animation.";
        color: Theme.fg-muted; font-size: Theme.fs-sm; wrap: word-wrap;
    }
    Button { label: "Apply Selected"; enabled: root.targets && (!Keyframes.animation-favourites-browser || Keyframes.has-favourite-pool); clicked => {root.apply(true,0);} }
    Button { label: "Apply All"; enabled: root.targets && (!Keyframes.animation-favourites-browser || Keyframes.has-favourite-pool); clicked => {root.apply(false,0);} }
    if !Keyframes.animation-favourites-browser: Button {
        label: Keyframes.animation-scope == 1 ? "Random Selected" : "Random Whole Timeline";
        enabled: root.targets; clicked => {root.apply(Keyframes.animation-scope == 1,2);}
    }
    if !Keyframes.animation-favourites-browser: Button {
        label: Keyframes.animation-selected < 9 ? "Favorite Basic / Physics Randomly" : "Favorite Canvas Motion Randomly";
        enabled: root.targets; clicked => {root.apply(Keyframes.animation-scope == 1,3);}
    }
}
