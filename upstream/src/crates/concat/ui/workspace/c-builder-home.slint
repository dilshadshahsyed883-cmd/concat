import { Theme } from "../theme/theme.slint";
import { Button, Modal } from "../primitives/modal.slint";
import { Glyph } from "../icons.slint";
import { Param, ParamFormat } from "../inspector/controls.slint";
import { PaneScroll } from "pane.slint";
import { Editor } from "../editor.slint";
import { CBuilderPane } from "c-builder.slint";
export component CBuilderHome inherits Rectangle {
    in property <string> generated-project;
    in property <string> output-folder;
    in property <bool> generating;
    in property <bool> used-pending;
    property <int> page:0;
    callback cancel-generation();
    callback retry-used();
    callback return-home(profile:string);
    callback open-generated();
    callback choose-output();
    background:Theme.launch-page;
    VerticalLayout {
        padding:12px;spacing:8px;
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Home"; enabled: !Editor.cb-busy; clicked => { root.return-home(builder.draft-profile); } }
            Text { text: "C Builder  /  Home"; color: Theme.fg; font-size: Theme.fs-lg;
                vertical-alignment: center; horizontal-stretch: 1; }
            if root.generating: Button { label: "Cancel"; clicked => { root.cancel-generation(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Output Folder"; enabled: !Editor.cb-busy; clicked => { root.choose-output(); } }
            Button { label: "Open in Editor"; primary: true;
                enabled: !Editor.cb-busy && root.generated-project != ""; clicked => { root.open-generated(); } }
            if root.used-pending: Button { label: "Retry used-media"; enabled: !Editor.cb-busy; clicked => { root.retry-used(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {text:"Output: " + root.output-folder;color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
        if root.generated-project!="": Text {text:"Generated: " + root.generated-project;color:Theme.fg-muted;wrap:word-wrap;font-size:Theme.fs-sm;}
        Text { text: "1  Media Library    /    2  Timeline Builder    /    3  Media Selection"; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        HorizontalLayout {
            spacing: 6px;
            Button { label:"Media Library"; primary:root.page==0; clicked=>{root.page=0;} }
            Button { label:"Timeline Builder"; primary:root.page==1; clicked=>{root.page=1;} }
            Button { label:"Media Selection"; primary:root.page==2; clicked=>{root.page=2;} }
        }
        // Navigation and actions remain outside the scroll viewport.
        PaneScroll {
            vertical-stretch:1;
            builder := CBuilderPane {
                page <=> root.page;
                can-generate:!root.used-pending;generating:root.generating;
                project-name:Editor.cb-project-name;name-overridden:Editor.cb-name-overridden;name-preview:Editor.cb-name-preview;
                project-name-edited(name)=>{Editor.cb-project-name-edited(name);}reset-project-name=>{Editor.cb-reset-project-name();}
                intro-folder:Editor.cb-intro-folder;intro-count:Editor.cb-intro-count;intro-probed:Editor.cb-intro-probed;intro-reused:Editor.cb-intro-reused;intro-summary:Editor.cb-intro-summary;
                intro-keywords:Editor.cb-intro-keywords;intro-selection-summary:Editor.cb-intro-selection-summary;
                import-intro-folder=>{Editor.cb-import-intro-folder();}refresh-intro-folder=>{Editor.cb-refresh-intro-folder();}clear-intro-folder=>{Editor.cb-clear-intro-folder();}
                intro-keyword-changed(json,keyword,selected,weight)=>{Editor.cb-intro-keyword-changed(json,keyword,selected,weight);}
                equalize-intro-keywords(json)=>{Editor.cb-equalize-intro-keywords(json);}
                media-folder:Editor.cb-media-folder;narration:Editor.cb-narration;narration-duration:Editor.cb-duration;
                status:Editor.cb-status;keywords:Editor.cb-keywords;image-count:Editor.cb-image-count;video-count:Editor.cb-video-count;
                cache-probed:Editor.cb-probed;cache-reused:Editor.cb-reused;scan-done:Editor.cb-scan-done;scan-total:Editor.cb-scan-total;
                busy:Editor.cb-busy;profile:Editor.cb-profile;preview:Editor.cb-preview;
                plan-opening: Editor.cb-plan-opening; plan-closing: Editor.cb-plan-closing; plan-intro: Editor.cb-plan-intro;
                plan-image-min: Editor.cb-plan-image-min; plan-image-max: Editor.cb-plan-image-max;
                plan-video-min: Editor.cb-plan-video-min; plan-video-max: Editor.cb-plan-video-max;
                plan-max-videos: Editor.cb-plan-max-videos; plan-max-images: Editor.cb-plan-max-images;
                plan-cooldown: Editor.cb-plan-cooldown; plan-seed: Editor.cb-plan-seed;
                tune-profile(json,opening,closing,intro,imin,imax,vmin,vmax,maxv,maxi,cooldown,seed) => {
                    Editor.cb-tune-profile(json,opening,closing,intro,imin,imax,vmin,vmax,maxv,maxi,cooldown,seed);
                }
                equalize-keywords(json,video) => { Editor.cb-equalize-keywords(json,video); }
                image-keywords:Editor.cb-image-keywords;video-keywords:Editor.cb-video-keywords;videos-enabled:Editor.cb-videos-enabled;
                overall-video-ratio:Editor.cb-overall-video-ratio; ratio-changed(value)=>{Editor.cb-overall-video-ratio-changed(value);}
                image-selection-summary:Editor.cb-image-selection-summary;video-selection-summary:Editor.cb-video-selection-summary;
                keyword-changed(json,video,keyword,selected,weight)=>{Editor.cb-keyword-changed(json,video,keyword,selected,weight);}
                videos-toggled(json,on)=>{Editor.cb-videos-toggled(json,on);}
                plan-profile(json,images,videos,action)=>{Editor.cb-plan-profile(json,images,videos,action);}
                import-folder=>{Editor.cb-import-folder();} refresh-folder=>{Editor.cb-refresh-folder();}
                choose-narration=>{Editor.cb-choose-narration();}
                generate-project(name,images,videos,coverage,profile)=>{Editor.cb-generate-project(name,images,videos,coverage,profile);}
            }
        }
    }
    property <bool> preview-expanded:false;
    property <bool> preview-visible:Editor.cb-preview-open;
    changed preview-visible => {root.preview-expanded=false;}
    Modal {
        open:Editor.cb-preview-open;
        title:Editor.cb-preview-title;
        glyph:Glyph.film;
        surface-width:900px;
        surface-height:620px;
        fill:root.preview-expanded;
        closed=>{Editor.cb-preview-close();}
        VerticalLayout {
            padding:12px;spacing:8px;vertical-stretch:1;
            Rectangle {
                background:#000000;
                vertical-stretch:1;
                min-height:80px;
                Image {width:parent.width;height:parent.height;source:Editor.cb-preview-image;image-fit:contain;}
            }
            Text {text:Editor.cb-preview-status;color:Theme.fg-muted;font-size:Theme.fs-sm;wrap:word-wrap;}
            Param {
                label:"Position";
                rail:true;
                value:Editor.cb-preview-time;
                minimum:0;maximum:Math.max(0.1,Editor.cb-preview-duration);
                step:0.1;unit:"s";fmt:ParamFormat.steps;
                enabled:Editor.cb-preview-ready;
                changed(v)=>{Editor.cb-preview-seek(v);}
            }
            HorizontalLayout {
                spacing:6px;
                Button {label:Editor.cb-preview-playing?"Pause":"Play";primary:true;enabled:Editor.cb-preview-ready;clicked=>{Editor.cb-preview-toggle();}}
                Button {label:"Replay";enabled:Editor.cb-preview-ready;clicked=>{Editor.cb-preview-seek(0);}}
                Button {label:Editor.cb-preview-muted?"Unmute":"Mute";enabled:Editor.cb-preview-ready;clicked=>{Editor.cb-preview-mute();}}
                Text {text:Math.round(Editor.cb-preview-time*10)/10+" / "+Math.round(Editor.cb-preview-duration*10)/10+" s";color:Theme.fg;vertical-alignment:center;}
                Rectangle {horizontal-stretch:1;}
                Button {label:root.preview-expanded?"Restore":"Expand";clicked=>{root.preview-expanded=!root.preview-expanded;}}
                Button {label:"Close";clicked=>{Editor.cb-preview-close();}}
            }
            Text {text:"Original timeline starts at "+Editor.cb-preview-start+"s · 480p · Narration only";color:Theme.fg-muted;font-size:Theme.fs-sm;}
        }
    }

}
