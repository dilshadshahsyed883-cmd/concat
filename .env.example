# Documentation sample only. Secrets and password hash must be created privately on VPS.
# Prefer the one-time root-only deploy/init-local-admin.py bootstrap; never
# commit real environment values, passwords, scrypt hashes, tokens or OAuth credentials.
CONCAT_AUTH_MODE=local-admin
CONCAT_ADMIN_USERNAME=
CONCAT_ADMIN_PASSWORD_HASH=
CONCAT_ADMIN_SESSION_SECRET=
CONCAT_WEB_SECURITY_DB=/var/lib/concat-web/security.sqlite3
CONCAT_WEB_DATA_ROOT=/var/lib/concat-web
CONCAT_WEB_PUBLIC_ORIGIN=https://concat.scenebuilder.online
CONCAT_PUBLIC_ORIGIN=https://concat.scenebuilder.online
CONCAT_UPLOADER_ENABLED=1
LUM_SESSION_SECRET=
LUM_DATA_DIR=/var/lib/concat-web/uploader
CONCAT_CLOUD_RENDER_ROOT=/var/lib/concat-web
CONCAT_WEB_HOST=127.0.0.1
CONCAT_WEB_PORT=18873

# Gateway enforces LUM_ENGINE_INSTANCE=concat, LUM_BASE_PATH=/concat-uploader,
# LUM_SUITE_AUTH=1, LUM_COOKIE_SECURE=1, CONCAT_WEB_IN_PROCESS=1.
# Do not expose reused uploader on another port.
# Read-only canonical Drive intake; no rclone/OAuth config access is granted.
CONCAT_DRIVE_BRIDGE_SOCKET=/run/concat-drive-bridge/intake.sock
